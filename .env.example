# Server
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME='YOUR_ACTUAL_DB_NAME'
DB_USER=postgres
DB_PASSWORD='YOUR_ACTUAL_POSTGRES_PASSWORD'

# Authentication (JWT)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Seeded Demo Credentials (used by scripts/seed.ts)
SEED_ADMIN_EMAIL=admin@finpilot.local
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_VIEWER_EMAIL=viewer@finpilot.local
SEED_VIEWER_PASSWORD=change_me_viewer_password