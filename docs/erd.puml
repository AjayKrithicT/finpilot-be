@startuml FinPilot_ERD
hide circle
skinparam linetype ortho
skinparam roundcorner 6
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #334155
  HeaderFontColor #FFFFFF
  ArrowColor #475569
}

entity "users" as users {
  * user_id : UUID <<PK>>
  --
  * email : VARCHAR(255) <<UNIQUE>>
  * password_hash : VARCHAR(255)
  * full_name : VARCHAR(120)
  * role : VARCHAR(20) <<CHECK: VIEWER|ADMIN>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "customers" as customers {
  * customer_id : VARCHAR(16) <<PK>>
  --
  * full_name : VARCHAR(150)
  * email : VARCHAR(255) <<UNIQUE>>
  * phone : VARCHAR(20)
  * city : VARCHAR(100)
  * state : VARCHAR(10)
  * date_of_birth : DATE
  * onboarded_at : DATE
  * kyc_status : VARCHAR(20) <<CHECK: VERIFIED|PENDING|REVIEW>>
  * segment : VARCHAR(20) <<CHECK: Mass|Affluent|HNI>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "risk_profiles" as risk_profiles {
  * customer_id : VARCHAR(16) <<PK, FK>>
  --
  * risk_score : SMALLINT <<CHECK: 0..100>>
  * risk_level : VARCHAR(20) <<CHECK: Conservative|Moderate|Growth|Aggressive>>
  * assessed_at : DATE
  * horizon_years : SMALLINT <<CHECK: > 0>>
  * liquidity_need : VARCHAR(10) <<CHECK: LOW|MEDIUM|HIGH>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "accounts" as accounts {
  * account_id : VARCHAR(16) <<PK>>
  --
  * customer_id : VARCHAR(16) <<FK>>
  * account_type : VARCHAR(20) <<CHECK: BROKERAGE|MUTUAL_FUND|RETIREMENT>>
  * provider : VARCHAR(120)
  * opened_at : DATE
  * status : VARCHAR(20) <<CHECK: ACTIVE|DORMANT|CLOSED>>
  * base_currency : CHAR(3)
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "instruments" as instruments {
  * instrument_id : VARCHAR(16) <<PK>>
  --
  * symbol : VARCHAR(32) <<UNIQUE>>
  * instrument_name : VARCHAR(150)
  * asset_class : VARCHAR(20) <<CHECK: EQUITY|ETF|MUTUAL_FUND|BOND|REIT|GSEC>>
  sector : VARCHAR(80)
  * exchange : VARCHAR(16) <<CHECK: NSE|BSE|OTC>>
  * currency : CHAR(3)
  * last_price : NUMERIC(18,4) <<CHECK: > 0>>
  * price_as_of : DATE
  * risk_band : VARCHAR(10) <<CHECK: LOW|MEDIUM|HIGH>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "holdings_snapshot" as holdings {
  * holding_id : BIGSERIAL <<PK>>
  --
  * account_id : VARCHAR(16) <<FK, UQ1>>
  * instrument_id : VARCHAR(16) <<FK, UQ1>>
  * snapshot_date : DATE <<UQ1>>
  * quantity : NUMERIC(18,6) <<CHECK: > 0>>
  * avg_cost : NUMERIC(18,4) <<CHECK: >= 0>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "transactions" as transactions {
  * transaction_id : VARCHAR(20) <<PK>>
  --
  * account_id : VARCHAR(16) <<FK>>
  * instrument_id : VARCHAR(16) <<FK>>
  * transaction_type : VARCHAR(20) <<CHECK: BUY|SELL|DIVIDEND|FEE>>
  * trade_date : DATE
  * quantity : NUMERIC(18,6) <<CHECK: >= 0>>
  * price : NUMERIC(18,4) <<CHECK: >= 0>>
  * amount : NUMERIC(18,2) <<CHECK: > 0>>
  * status : VARCHAR(20) <<CHECK: SETTLED|PENDING|REVERSED>>
  import_batch_id : UUID <<FK>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "goals" as goals {
  * goal_id : VARCHAR(16) <<PK>>
  --
  * customer_id : VARCHAR(16) <<FK>>
  * goal_type : VARCHAR(30) <<CHECK: WEALTH_CREATION|EMERGENCY_FUND|EDUCATION|HOME_PURCHASE|RETIREMENT|TRAVEL>>
  * goal_name : VARCHAR(150)
  * target_amount : NUMERIC(18,2) <<CHECK: > 0>>
  * current_funded_amount : NUMERIC(18,2) <<CHECK: >= 0>>
  * target_date : DATE
  * priority : VARCHAR(10) <<CHECK: LOW|MEDIUM|HIGH>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "import_batches" as batches {
  * batch_id : UUID <<PK>>
  --
  * entity_type : VARCHAR(30)
  * file_name : VARCHAR(255)
  * file_checksum : VARCHAR(64)
  * total_rows : INTEGER
  * imported_rows : INTEGER
  * rejected_rows : INTEGER
  * status : VARCHAR(20) <<CHECK: COMPLETED|FAILED>>
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "import_rejections" as rejections {
  * rejection_id : BIGSERIAL <<PK>>
  --
  * batch_id : UUID <<FK>>
  * row_number : INTEGER
  record_identifier : VARCHAR(64)
  * error_code : VARCHAR(50)
  * error_reason : TEXT
  * raw_payload : JSONB
  --
  created_by : UUID <<FK>>
  * created_at : TIMESTAMPTZ
  modified_by : UUID <<FK>>
  * modified_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

' Domain Relationships
customers ||--|| risk_profiles : "has latest"
customers ||--o{ accounts : "owns"
customers ||--o{ goals : "tracks"
accounts ||--o{ holdings : "holds"
instruments ||--o{ holdings : "valued in"
accounts ||--o{ transactions : "records"
instruments ||--o{ transactions : "traded in"
batches ||--o{ rejections : "logs anomalies"
batches |o--o{ transactions : "ingests"

' Audit Relationships
users |o--o{ users : "audits"
users |o--o{ customers : "audits"
users |o--o{ risk_profiles : "audits"
users |o--o{ accounts : "audits"
users |o--o{ instruments : "audits"
users |o--o{ holdings : "audits"
users |o--o{ transactions : "audits"
users |o--o{ goals : "audits"
users |o--o{ batches : "uploads / audits"
users |o--o{ rejections : "audits"

@enduml